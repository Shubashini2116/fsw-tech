# Environment Variables Example for TaskFlow / ResQ Command Full-Stack Platform

# Server Port (Default: 8080 or assigned dynamically by cloud host like Render/Railway/Heroku)
PORT=8080

# Active Spring Profile (optional: use 'h2' for standalone zero-config database, or leave blank for MySQL)
# SPRING_PROFILES_ACTIVE=h2

# Database Connection (MySQL / PostgreSQL / Cloud DB)
DB_URL=jdbc:mysql://localhost:3306/taskflow_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JWT Security Configuration
JWT_SECRET=YourSuperSecretKeyAtLeast256BitsLongForHMACSHA256SignatureAuthentication!
JWT_EXPIRATION_MS=86400000

# Frontend API URL Override (Leave empty to use same-origin /api automatically)
# TASKFLOW_API_URL=https://your-app-name.onrender.com/api
